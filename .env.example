# ─────────────────────────────────────────────────────────────
# TT Brothers — Environment Variables
# Copy to .env.local and fill in real values. NEVER commit .env.local
# ─────────────────────────────────────────────────────────────

# ── Supabase (Project Settings → API) ────────────────────────
# Safe to expose in the browser (protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# SERVER ONLY — bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── Paystack (Settings → API Keys & Webhooks) ────────────────
# Public key is safe for the browser (used to initialize Paystack checkout)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=YOUR-PAYSTACK-PUBLIC-KEY

# SERVER ONLY — used to initialize + verify transactions. Never expose.
PAYSTACK_SECRET_KEY=YOUR-PAYSTACK-SECRET-KEY

# ── App ──────────────────────────────────────────────────────
# Canonical site URL (no trailing slash). Used for SEO, callbacks, redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Business contact (placeholders — replace with real values) ─
# International format without "+" or spaces. Example: 233201234567
WHATSAPP_NUMBER=233XXXXXXXXX
